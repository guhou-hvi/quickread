{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/blind-candidate.schema.json",
  "title": "QuickRead blind claim candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "role", "reviewerId", "reviewRound", "inputHashes", "blindToEvidence", "entries"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "caseId": { "type": "string", "minLength": 1 },
    "role": { "const": "blind_recall" },
    "reviewerId": { "type": "string", "minLength": 2 },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments"],
      "properties": { "segments": { "$ref": "#/$defs/hash" } }
    },
    "blindToEvidence": { "const": true },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "importance", "claimRole", "supportSpans"],
        "properties": {
          "id": { "type": "string", "pattern": "^BC[0-9]{4,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "importance": { "enum": ["high", "medium", "low"] },
          "importanceRationale": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "claimRole": { "enum": ["fact", "opinion", "prediction", "recollection", "example", "rebuttal", "limitation", "uncertainty"] },
          "supportSpans": { "type": "array", "minItems": 1, "items": { "$ref": "evidence.schema.json#/properties/supportSpans/items" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.1.0" } }, "required": ["schemaVersion"] },
      "then": {
        "properties": {
          "entries": {
            "items": { "required": ["id", "statement", "importance", "importanceRationale", "confidence", "claimRole", "supportSpans"] }
          }
        }
      }
    }
  ],
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
