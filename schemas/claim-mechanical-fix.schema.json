{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/claim-mechanical-fix.schema.json",
  "title": "QuickRead validated mechanical claim fix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "caseId", "role", "reviewRound", "inputHashes", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workflowVersion": { "const": "2.2.1" },
    "caseId": { "type": "string", "minLength": 1 },
    "role": { "const": "claim_mechanical_fix" },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryClaimReview", "beforeEvidence", "afterEvidence", "beforeQuoteIgnoredEvidence", "afterQuoteIgnoredEvidence"],
      "properties": {
        "primaryClaimReview": { "$ref": "#/$defs/hash" },
        "beforeEvidence": { "$ref": "#/$defs/hash" },
        "afterEvidence": { "$ref": "#/$defs/hash" },
        "beforeQuoteIgnoredEvidence": { "$ref": "#/$defs/hash" },
        "afterQuoteIgnoredEvidence": { "$ref": "#/$defs/hash" },
        "beforeEvidenceMigration": { "$ref": "#/$defs/hash" },
        "afterEvidenceMigration": { "$ref": "#/$defs/hash" }
      },
      "dependentRequired": {
        "beforeEvidenceMigration": ["afterEvidenceMigration"],
        "afterEvidenceMigration": ["beforeEvidenceMigration"]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "description": "Complete ledger of every supportSpans.quote addition in the evidence repair. Entries may include claims that were not primary missing_support_quote findings; eligibility for mechanicalResolvedCount is computed separately from the primary review.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceRef", "findingCode", "status", "supportSpanIndexes"],
        "properties": {
          "evidenceRef": { "$ref": "#/$defs/evidenceRef" },
          "findingCode": { "const": "missing_support_quote" },
          "status": { "const": "mechanically_resolved" },
          "supportSpanIndexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceRef": { "type": "string", "pattern": "^E[0-9]{4,}$" }
  }
}
