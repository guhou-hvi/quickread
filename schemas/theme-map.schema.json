{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/theme-map.schema.json",
  "title": "QuickRead claim-to-theme map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "profile", "themes", "unassignedClaimRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "type": "string" },
    "profile": { "enum": ["knowledge", "strategy", "narrative", "debate", "general"] },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "summary", "profileModules", "claimRefs", "importanceCoverage"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "profileModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "claimRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^E[0-9]{4,}$" } },
          "importanceCoverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["high", "medium", "low"],
            "properties": { "high": { "type": "integer", "minimum": 0 }, "medium": { "type": "integer", "minimum": 0 }, "low": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "unassignedClaimRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}
