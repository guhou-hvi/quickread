{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/source-match.schema.json",
  "title": "QuickRead source match audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "queriedAt", "status", "selectedUrl", "candidates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "type": "string", "pattern": "^qr-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "queriedAt": { "type": "string", "format": "date" },
    "status": { "enum": ["verified", "pending"] },
    "selectedUrl": { "type": ["string", "null"], "format": "uri" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "publisher", "publishedAt", "duration", "matchedSignals", "confidence", "notes"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": ["string", "null"] },
          "publishedAt": { "type": ["string", "null"], "format": "date" },
          "duration": { "type": ["string", "null"] },
          "matchedSignals": {
            "type": "array",
            "items": { "enum": ["title", "participant", "publisher", "duration"] },
            "uniqueItems": true
          },
          "confidence": { "enum": ["high", "medium", "low"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
