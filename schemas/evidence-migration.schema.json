{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/evidence-migration.schema.json",
  "title": "QuickRead evidence ID migration ledger",
  "oneOf": [
    { "$ref": "#/$defs/fullMigration" },
    { "$ref": "#/$defs/semanticRepair" }
  ],
  "$defs": {
    "fullMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "caseId", "fromWorkflow", "toWorkflow", "inputHashes", "entries"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "caseId": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "fromWorkflow": { "type": "string", "minLength": 1 },
        "toWorkflow": { "const": "2.2.0" },
        "inputHashes": { "$ref": "#/$defs/inputHashes" },
        "entries": { "$ref": "#/$defs/entries" }
      }
    },
    "semanticRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "migrationKind", "caseId", "reviewPolicyVersion", "repairRound", "baselinePath", "inputHashes", "entries"],
      "properties": {
        "schemaVersion": { "const": "1.1.0" },
        "migrationKind": { "const": "semantic_repair" },
        "caseId": { "type": "string", "minLength": 1 },
        "reviewPolicyVersion": { "const": "2.3.2" },
        "repairRound": { "type": "integer", "minimum": 1 },
        "baselinePath": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "inputHashes": { "$ref": "#/$defs/inputHashes" },
        "entries": { "$ref": "#/$defs/entries" }
      }
    },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oldEvidence", "newEvidence"],
      "properties": {
        "oldEvidence": { "$ref": "#/$defs/hash" },
        "newEvidence": { "$ref": "#/$defs/hash" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "oldEvidenceRefs", "newEvidenceRefs", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^EM[0-9]{4,}$" },
        "status": { "enum": ["preserved", "rewritten", "split", "merged", "retired", "new_claim"] },
        "oldEvidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "newEvidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^E[0-9]{4,}$" }
    }
  }
}
