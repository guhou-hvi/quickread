{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/publish-manifest.schema.json",
  "title": "QuickRead immutable publish generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "stageId",
    "generationId",
    "status",
    "createdAt",
    "gatedAt",
    "versions",
    "inputHashes",
    "artifacts",
    "reports",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "type": "string", "pattern": "^qr-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stageId": { "type": "string", "minLength": 1 },
    "generationId": { "$ref": "#/$defs/generationId" },
    "status": { "const": "gated" },
    "createdAt": { "type": "string", "format": "date-time" },
    "gatedAt": { "type": "string", "format": "date-time" },
    "supersedes": {
      "oneOf": [
        { "$ref": "#/$defs/generationId" },
        { "type": "null" }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "prompt", "template", "public"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "public": { "type": "string", "minLength": 1 },
        "qualitySchema": { "type": "string", "minLength": 1 },
        "renderSchema": { "type": "string", "minLength": 1 }
      }
    },
    "inputHashes": { "$ref": "#/$defs/hashMap" },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes", "mediaType"],
        "properties": {
          "sha256": { "$ref": "#/$defs/hash" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "status", "errorCount"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/hash" },
          "status": { "const": "pass" },
          "errorCount": { "const": 0 }
        }
      },
      "required": ["quality", "render", "validate"]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "quality", "render", "validate", "hashes", "requiredArtifacts"],
      "properties": {
        "status": { "const": "pass" },
        "quality": { "const": "pass" },
        "render": { "const": "pass" },
        "validate": { "const": "pass" },
        "hashes": { "const": "pass" },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationId": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+(?:/[^\\\\]+)*$"
    },
    "hashMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    }
  }
}
