{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/render-report.schema.json",
  "title": "QuickRead render report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "browserPath", "png", "mobilePng", "desktop", "mobile", "mobileExport", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.3.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "browserPath": { "type": "string" },
    "png": { "type": "object" },
    "mobilePng": {
      "type": "object",
      "required": ["path", "width", "height", "segments"],
      "properties": {
        "path": { "type": "string" },
        "width": { "const": 1080 },
        "height": { "type": "integer", "minimum": 1 },
        "segments": { "type": "array", "items": { "type": "object" } }
      }
    },
    "desktop": { "type": "object" },
    "mobile": { "type": "object" },
    "mobileExport": { "type": "object" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
