{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickread.local/schemas/segment.schema.json",
  "title": "QuickRead semantic source segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "caseId", "sourceIds", "contextBefore", "contextAfter", "locator", "text", "speaker"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^S[0-9]{4,}$" },
    "caseId": { "type": "string" },
    "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "contextBefore": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "contextAfter": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "enum": ["time", "section", "paragraph"] },
        "label": { "type": "string", "minLength": 1 },
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "heading": { "type": ["string", "null"] }
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "confidence"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "status": { "enum": ["confirmed", "inferred", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
